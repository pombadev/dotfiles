#!/usr/bin/env python3
"""Equalize column widths on the focused niri workspace."""
import json
import subprocess


def msg(*args):
    return subprocess.run(
        ["niri", "msg", *args], capture_output=True, text=True, check=True
    ).stdout


def msg_json(kind):
    return json.loads(msg("-j", kind))


def main():
    ws = next(w for w in msg_json("workspaces") if w["is_focused"])

    columns = set()
    focused_col = None
    for win in msg_json("windows"):
        if win["workspace_id"] != ws["id"]:
            continue
        pos = (win.get("layout") or {}).get("pos_in_scrolling_layout")
        if pos is None:  # floating
            continue
        columns.add(pos[0])
        if win.get("is_focused"):
            focused_col = pos[0]

    n = len(columns)
    if n < 2:
        return

    width = f"{100 / n:.4f}%"
    msg("action", "focus-column-first")
    for _ in range(n):
        msg("action", "set-column-width", width)
        msg("action", "focus-column-right")

    # focus-column-right wraps back to the first column after the last one
    if focused_col is not None:
        for _ in range(focused_col - min(columns)):
            msg("action", "focus-column-right")


if __name__ == "__main__":
    main()