// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=wr_1786211980152207940 @name=com.example.ourpot
window-rule {
    match app-id="^com.example.ourpot$" is-floating=true
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}

// @id=wr_1791781621114253133 @name=valent
window-rule {
    match app-id="^valent$"
    open-floating true
    min-height 900
}

// @id=wr_1791781892130963236 @name=io.github.nozwock.Packet
window-rule {
    match app-id="^io.github.nozwock.Packet$"
    open-floating true
    open-focused true
}
