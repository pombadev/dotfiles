{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "$HOME/.local/bin/agent-statusline --no-tag --no-rc"
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "dart-flutter@dart-flutter": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "dart-flutter": {
      "source": {
        "source": "github",
        "repo": "flutter/agent-plugins"
      }
    }
  },
  "effortLevel": "high",
  "companyAnnouncements": [
    "Prompt check: what you want, why, where, and how you will judge it. Anything you leave out, I fill in with a guess."
  ],
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "verbose": true,
  "preferredNotifChannel": "notifications_disabled",
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
