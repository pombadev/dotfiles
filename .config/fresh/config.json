{
  "theme": "one-pro.json",
  "editor": {
    "show_horizontal_scrollbar": true,
    "highlight_current_column": true,
    "completion_popup_auto_show": true,
    "show_prompt_line": true,
    "whitespace_spaces_inner": true,
    "whitespace_spaces_trailing": true,
    "whitespace_carriage_returns": true,
    "whitespace_newlines": true,
    "whitespace_spaces_leading": true,
    "cursor_jump_animation": false,
    "rainbow_indentation": true,
    "indentation_guide": "all",
    "virtual_space": "off",
    "trim_trailing_whitespace_on_save": true,
    "status_bar": {
      "left": ["{trust}", "{diagnostics}", "{cursor:compact}", "{filename}", "{git_statusbar:branch}"],
      "right": ["{read_only}", "{line_ending}", "{encoding}", "{language}", "{lsp}", "{warnings}", "{update}", "{palette}"]
    },
    "enable_inlay_hints": true
  },
  "file_explorer": {
    "show_hidden": true,
    "show_gitignored": true
  },
  "file_browser": {
    "show_hidden": true
  },
  "terminal": {
    "mouse_drag_selects": true
  },
  "version": 2,
  "lsp": {
    "ocaml": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    },
    "jsonc": [
      {
        "command": "~/.npm/packages/bin/vscode-json-languageserver",
        "enabled": true,
        "args": ["--stdio"],
        "auto_start": true,
        "process_limits": {
          "max_memory_percent": 50,
          "max_cpu_percent": 90,
          "enabled": true
        }
      }
    ],
    "json": [
      {
        "command": "~/.npm/packages/bin/vscode-json-languageserver",
        "enabled": true,
        "args": ["--stdio"],
        "auto_start": true,
        "process_limits": {
          "max_memory_percent": 50,
          "max_cpu_percent": 90,
          "enabled": true
        }
      }
    ]
  },
  "plugins": {
    "vi_mode": {
      "enabled": true,
      "settings": {
        "autoStart": false,
        "arrowKeys": true,
        "searchWordUnderCursor": true
      }
    },
    "git_explorer": {
      "settings": {
        "colorNames": true
      },
      "enabled": true
    },
    "dashboard": {
      "settings": {
        "autoOpen": true
      },
      "enabled": true
    },
    "welcome_screen": {
      "enabled": true,
      "settings": {
        "showOnStartup": true
      }
    },
    "orchestrator": {
      "enabled": true,
      "settings": {
        "autoOpenDock": "auto",
        "defaultView": "compact",
        "showAllWorktrees": false,
        "showEmptyWorkspaces": true,
        "notifications": "all",
        "notifySound": false
      }
    }
  },
  "keybindings": [
    {
      "key": "o",
      "modifiers": ["ctrl", "alt"],
      "action": "quick_open_files",
      "when": "global"
    }
  ],
  "orchestrator_mode": false
}